    }
  ],
  "scenes": [
    {
      "id": "S1",
      "place": "候潮室",
      "narration": "晚潮前众人等守楼人。"
    },
    {
      "id": "S2",
      "place": "长阶",
      "narration": "余舟愿意留在长阶下。"
    },
    {
      "id": "S3",
      "place": "回声廊",
      "narration": "阿芹没有出门，廊内能听回声。"
    },
    {
      "id": "S4",
      "place": "钥匙间",
      "narration": "余舟需实际持有楼钥匙，随后才可以开门。"
    },
    {
      "id": "S5",
      "place": "二层转角",
      "narration": "走楼外的另一条路，无需楼钥匙。"
    },
    {
      "id": "S6",
      "place": "楼顶",
      "narration": "风已起，两种入楼方式在此会合。"
    },
    {
      "id": "S7",
      "place": "还钥匙处",
      "narration": "可以改主意收回钥匙。"
    }
  ],
  "edges": [
    {
      "id": "E1",
      "origin": "S1",
      "target": "S2",
      "option": "陪余舟等",
      "trigger": "余舟答应留下"
    },
    {
      "id": "E2",
      "origin": "S1",
      "target": "S3",
      "option": "去听长廊",
      "trigger": "没有请余舟守候"
    },
    {
      "id": "E3",
      "origin": "S2",
      "target": "S4",
      "option": "走室内",
      "trigger": "余舟手里有楼钥匙"
    },
    {
      "id": "E4",
      "origin": "S3",
      "target": "S4",
      "option": "直接开门",
      "trigger": "余舟相信钥匙已交接"
    },
    {
